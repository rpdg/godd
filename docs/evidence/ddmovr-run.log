[protocol] item="probe=ddmovr purpose=DD_movR relative displacement and a capped closed-loop measurement"
[protocol] item="nonclaim=probe algorithm is not a godd API and is not the winput trajectory"
[protocol] item="nonclaim=a converged token does not accept a later winput change"
[protocol] item="nonclaim=one (+50,+50) sample is not a convergence result"
[protocol] item="tolerance_px=1"
[protocol] item="max_steps=12"
[protocol] item="trial_timeout=3s"
[protocol] item="max_step_px=40"
[protocol] item="inter_step=16ms"
[protocol] item="admission_headroom=2"
[protocol] item="edge_margin_px=80"
[protocol] item="anomaly_slack_px=15"
[protocol] item="hard_gain=8"
[protocol] item="samples_ms=0,20,80"
[protocol] item="burst_gaps_ms=0,8,30"
[protocol] item="burst_count=5"
[protocol] item="pass_converged=abs error <= tolerance on both axes, within max_steps and trial_timeout, every sample inside the safe rect, wrapper ret 1"
[protocol] item="pass_unit_sample=wrapper ret 1, sample stayed in the safe rect, sample at 0ms and 80ms differ by at most 1px per axis, crosstalk <= 1px"
[protocol] item="run_abort=api-error edge left-monitor diverged anomaly-delta contaminated no-displacement interrupted edge-risk control-failed"
[protocol] item="not_run_abort=converged max-steps timeout skipped-clearance"
[protocol] item="exit_priority=converged,timeout,max-steps"
[protocol] item="sign_stop=after +/-10, against-axis motion beyond 1px stops the run; one call aborts immediately only when inversion exceeds anomaly_slack_px"
[protocol] item="reposition_settle=100ms"
[protocol] item="control_settle=250ms"
[protocol] item="idle=5x100ms"
[protocol] item="no_retry=each trial runs at most once"
[protocol] item="interrupt=Ctrl+C is observed between DLL calls; a call inside the DLL cannot be cancelled; killing the process skips cursor restore"
[protocol] item="environment=no pointer, DPI, driver, or package change; this process may call SetProcessDPIAware"
[protocol] item="reposition=SetCursorPos returns to home between trials; closed-loop steps call only DD_movR"
[protocol] item="wrapper_ret=MoveRelative nil is logged as ret 1; other codes are parsed from the wrapper error"
[protocol] item="tokens=filename and version numbers are recorded; a difference does not refuse the run, and a match does not prove driver compatibility"
[protocol] item="exports=the godd export set is checked so the wrapper can resolve them; matching exports do not prove the installed driver accepts the DLL"
[protocol] item="pointer_guard=SPI speed and enhancement are compared again after the idle check; a difference aborts before motion"
